# Copy to .env and edit. Never commit .env.
# Directly connected USB UVC camera (use /dev/v4l/by-id/...-video-index0 for stable naming).
CAMERA_DEVICE=/dev/video0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=15
CAMERA_FOURCC=MJPG
# Leave unset if the HEF is at ./models/yolo26n.hef
# HEF_PATH=/absolute/path/to/yolo26n.hef

TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=REPLACE_WITH_YOUR_BOT_TOKEN
TELEGRAM_CHAT_ID=REPLACE_WITH_YOUR_CHAT_ID

CONF_THRESHOLD=0.35
NMS_IOU_THRESHOLD=0.45
INFERENCE_INTERVAL_SECONDS=0.5
EMPTY_TIMEOUT_SECONDS=300
REARM_PERSON_SECONDS=10
REQUIRE_PRIOR_PRESENCE=false
TELEGRAM_RETRY_SECONDS=60
SNAPSHOT_LOOKBACK_SECONDS=20
SNAPSHOT_INTERVAL_SECONDS=0.5
MAX_SNAPSHOT_CANDIDATES=60
SAVE_EVENT_SNAPSHOTS=false
# EVENT_DIR=/home/pi/monitor-events